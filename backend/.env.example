# MotherCare AI — Required Environment Variables
# Copy this file to .env and fill in all values before deployment.
# NEVER commit .env with real secrets.

# ─── Security (REQUIRED) ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MC_SECRET_KEY=CHANGE_ME_generate_a_secure_48char_min_key

# ─── AI Provider (REQUIRED) ──────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_your_google_gemini_api_key

# ─── Database (OPTIONAL — defaults to local SQLite) ───────────────────────────
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/mothercare_db
DATABASE_URL=sqlite:///./mothercare.db

# ─── CORS (OPTIONAL — set to production frontend domain) ─────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Token expiry (OPTIONAL — defaults below) ─────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting (OPTIONAL) ────────────────────────────────────────────────
RATE_LIMIT_AUTH=10        # requests per minute for /auth endpoints
RATE_LIMIT_ANALYZE=20     # requests per minute for /analyze endpoint
RATE_LIMIT_AI=30          # requests per minute for /ai endpoints

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development    # development | staging | production
