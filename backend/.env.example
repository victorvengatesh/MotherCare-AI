# MotherCare AI Backend Configuration
# Copy this file to .env and fill in the values

# ──────────────────────────────────────────────────────────────
# Google Gemini API Configuration
# ──────────────────────────────────────────────────────────────
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MC_SECRET_KEY=your-secure-random-key-min-32-chars

# ──────────────────────────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./data/mothercare.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/mothercare_ai

# ──────────────────────────────────────────────────────────────
# CORS & Allowed Origins
# ──────────────────────────────────────────────────────────────
# Frontend URLs that can access this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────
# Options: development, staging, production
ENVIRONMENT=development

# ──────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────
# Rate Limiting Configuration
# ──────────────────────────────────────────────────────────────
# Auth endpoints: max requests per window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60

# Chat endpoints: max requests per user per window
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW=60

# Upload endpoints: max uploads per user per window
RATE_LIMIT_UPLOAD_MAX=5
RATE_LIMIT_UPLOAD_WINDOW=300

# ──────────────────────────────────────────────────────────────
# Circuit Breaker Configuration
# ──────────────────────────────────────────────────────────────
# Gemini API circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ──────────────────────────────────────────────────────────────
# File Upload Configuration
# ──────────────────────────────────────────────────────────────
# Maximum file size in bytes (10MB = 10485760)
MAX_UPLOAD_SIZE=10485760

# Allowed file types (comma-separated MIME types)
ALLOWED_UPLOAD_TYPES=application/pdf

# ──────────────────────────────────────────────────────────────
# Optional: Email Configuration (for future notifications)
# ──────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@example.com

# ──────────────────────────────────────────────────────────────
# Optional: Monitoring & Observability
# ──────────────────────────────────────────────────────────────
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# DATADOG_API_KEY=your_datadog_api_key
# NEW_RELIC_LICENSE_KEY=your_new_relic_key
