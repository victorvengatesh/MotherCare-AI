# MotherCare AI — Required Environment Variables
# Copy this file to .env and fill in all values before deployment.
# NEVER commit .env with real secrets.

# ─── Security (REQUIRED) ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MC_SECRET_KEY=CHANGE_ME_generate_a_secure_48char_min_key

# ─── AI Provider (REQUIRED) ──────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_your_google_gemini_api_key

# ─── Database (OPTIONAL — defaults to local SQLite) ───────────────────────────
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/mothercare_db
DATABASE_URL=sqlite:///./mothercare.db

# ─── CORS (OPTIONAL — set to production frontend domain) ─────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Token expiry (OPTIONAL — defaults below) ─────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting (OPTIONAL) ────────────────────────────────────────────────
RATE_LIMIT_AUTH=10        # requests per minute for /auth endpoints
RATE_LIMIT_ANALYZE=20     # requests per minute for /analyze endpoint
RATE_LIMIT_AI=30          # requests per minute for /ai endpoints

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development    # development | staging | production

# ─── PostgreSQL (required only by Docker Compose / production) ────────────────
# To use PostgreSQL manually, replace DATABASE_URL above with:
# DATABASE_URL=postgresql://mothercare:change_me@localhost:5432/mothercare_db
POSTGRES_DB=mothercare_db
POSTGRES_USER=mothercare
POSTGRES_PASSWORD=CHANGE_ME_generate_a_secure_database_password

# ─── Redis (Phase 4 — caching + WebSocket pub/sub) ───────────────────────────
# Leave blank to use in-memory fallback (dev without Docker)
# Docker Compose: set automatically by docker-compose.yml
REDIS_URL=redis://localhost:6379/0

# ─── Email / SMTP (Phase 4 — optional, skip to disable email) ────────────────
# Gmail example:
#   1. Enable 2FA on your Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use your Gmail address as SMTP_USER and the App Password as SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here

# SendGrid example (alternative):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

FROM_EMAIL=noreply@mothercare.ai
FROM_NAME=MotherCare AI

# ─── WebSocket (Phase 4) ─────────────────────────────────────────────────────
# Frontend connects to:  ws://<host>/ws/notifications?token=<JWT>
# No extra config needed — inherits ALLOWED_ORIGINS and MC_SECRET_KEY above.
