# Root .gitignore
# Ignore Node.js and Python artifacts

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Backend
**/__pycache__/
**/*.pyc
backend/.venv/
backend/venv/
backend/.env
backend/uploads/*
!backend/uploads/.gitkeep

# AI / Model
model/__pycache__/
model/experiments/.ipynb_checkpoints/

# Data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/samples/*
!data/samples/.gitkeep

# IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo

# Misc
.DS_Store
Thumbs.db

# Databases — never commit real patient data
backend/*.db
backend/**/*.db
*.sqlite
*.sqlite3

# PDF summaries — sensitive, never commit
backend/temp_pdfs/
mc_summary_*.pdf
*.pdf

# Vector database — can contain patient text fragments
backend/app/chroma_db/
backend/**/*.chroma/

# ML model files — may contain sensitive training patterns
backend/**/*.pkl
backend/**/*.joblib
backend/**/*.h5

# Temp uploads
backend/uploads/*.pdf
backend/uploads/*.png
backend/uploads/*.jpg
backend/uploads/*.jpeg

