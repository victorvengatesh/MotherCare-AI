# =============================================================================
# MotherCare AI — Production Environment Variables Configuration Template
# Instructions: Copy this file to '.env' and fill in the missing secret keys.
# =============================================================================

# ── Core Server Settings ──────────────────────────────────────────────────────
# MC_SECRET_KEY: Used for JWT signing. Generate a strong key (e.g. openssl rand -hex 32)
MC_SECRET_KEY=replace_this_with_a_secure_hex_key_32_bytes

# GEMINI_API_KEY: Google Gemini Developer API key for AI Agent orchestrators
GEMINI_API_KEY=replace_this_with_your_gemini_api_key

# LOG_FORMAT: 'json' for production structured indexing, 'text' for development
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Database & Redis ─────────────────────────────────────────────────────────
# PostgreSQL Database Credentials
POSTGRES_DB=mothercare_db
POSTGRES_USER=mothercare
POSTGRES_PASSWORD=replace_this_with_a_secure_db_password

# Database URL used by SQLAlchemy (points to postgres service inside Docker network)
DATABASE_URL=postgresql://mothercare:replace_this_with_a_secure_db_password@postgres:5432/mothercare_db

# Redis connection url
REDIS_URL=redis://redis:6379/0

# ── Network & Security ────────────────────────────────────────────────────────
# In production, ALLOWED_ORIGINS should restrict CORS requests to secure domains
ALLOWED_ORIGINS=https://localhost,http://localhost

# ── Email SMTP Service (Optional) ─────────────────────────────────────────────
# Leave empty to run with mock emails, or fill to send verification & alert mails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@mothercare.ai
FROM_NAME=MotherCare AI
