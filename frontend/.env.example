# MotherCare AI Frontend Configuration
# Copy this file to .env.local and fill in the values

# ──────────────────────────────────────────────────────────────
# Backend API Configuration
# ──────────────────────────────────────────────────────────────
# Backend API endpoint (local development uses port 8000, Docker uses 8000)
VITE_API_URL=http://127.0.0.1:8000

# ──────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────
# Options: development, staging, production
VITE_ENVIRONMENT=development

# ──────────────────────────────────────────────────────────────
# Application Configuration
# ──────────────────────────────────────────────────────────────
# Application title/name
VITE_APP_NAME=MotherCare AI

# Default language
VITE_DEFAULT_LANGUAGE=English

# ──────────────────────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────────────────────
# Enable/disable features
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_DARK_MODE=false

# ──────────────────────────────────────────────────────────────
# Client-Side Rate Limiting
# ──────────────────────────────────────────────────────────────
# Max requests per minute (client-side enforcement)
VITE_MAX_REQUESTS_PER_MINUTE=60

# ──────────────────────────────────────────────────────────────
# Optional: Analytics
# ──────────────────────────────────────────────────────────────
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_MIXPANEL_TOKEN=your_mixpanel_token

# ──────────────────────────────────────────────────────────────
# Optional: Error Tracking
# ──────────────────────────────────────────────────────────────
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_ERROR_REPORTING_ENABLED=true
